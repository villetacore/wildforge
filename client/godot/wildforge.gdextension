[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]

macos.debug = "res://../rust/target/debug/libwildforge_client.dylib"
macos.release = "res://../rust/target/release/libwildforge_client.dylib"
linux.debug.x86_64 = "res://../rust/target/debug/libwildforge_client.so"
linux.release.x86_64 = "res://../rust/target/release/libwildforge_client.so"
windows.debug.x86_64 = "res://../rust/target/debug/wildforge_client.dll"
windows.release.x86_64 = "res://../rust/target/release/wildforge_client.dll"
